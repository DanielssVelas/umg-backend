# ==========================================
# Variables de Entorno - Ambiente MAIN / PRODUCCIÓN (Azure VPS)
# Ubicación: etc/main/.env.example
# Copiar a etc/main/.env y rellenar con valores de Azure
# ==========================================

PORT=4001
NODE_ENV=production
TIMEOUT=90s
ENABLE_LOG_FILE=false

JWT_SECRET=tu_secreto_jwt_super_seguro_produccion_azure

# Conexión Oracle para Producción
ORACLE_USER=LAB1
ORACLE_PASSWORD=tu_password_oracle_produccion
# En Azure: colocar la IP o dominio del servidor donde corre Oracle
ORACLE_CONNECT_STRING=IP_SERVIDOR_ORACLE:1521/ORCLPDB

ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=10
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_CALL_TIMEOUT=30000
