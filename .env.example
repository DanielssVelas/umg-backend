# ===================================================
# UMG Backend - Variables de Entorno (.env.example)
# Copia este archivo a .env y actualiza los valores según tu entorno:
# cp .env.example .env
# ===================================================

# Configuración del Servidor
PORT=4001
NODE_ENV=production
TIMEOUT=90s
ENABLE_LOG_FILE=false

# Autenticación y Seguridad
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui

# Conexión a Base de Datos Oracle
# Para producción en VPS Azure:
# Si Oracle corre en el mismo servidor en Docker o nativo: IP_PUBLICA/PRIVADA:1521/NOMBRE_SERVICIO
# Ejemplo: 10.0.0.4:1521/ORCLPDB o localhost:1521/ORCLPDB
ORACLE_USER=LAB1
ORACLE_PASSWORD=tu_password_oracle_aqui
ORACLE_CONNECT_STRING=localhost:1521/ORCLPDB

# Configuración de Pool de Conexiones Oracle
ORACLE_POOL_MIN=1
ORACLE_POOL_MAX=5
ORACLE_POOL_INCREMENT=1
ORACLE_POOL_TIMEOUT=60
ORACLE_CALL_TIMEOUT=30000
